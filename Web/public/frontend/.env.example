# URL de public/backend (API de la tienda). Sin ella se usa http://localhost:4100/api.
VITE_API_URL=http://localhost:4100/api

# Modo sandbox de Wompi. Solo con "true" el checkout muestra el botón
# "Usar tarjeta de prueba" y el aviso "no se cobra dinero real". Ponlo en
# "true" únicamente mientras public/backend use credenciales de Wompi de
# prueba; en producción déjalo vacío o en "false" (cualquier otro valor se
# trata como producción). Al ser una variable de Vite, se lee al compilar:
# después de cambiarla hay que reiniciar `npm run dev` o volver a hacer build.
VITE_WOMPI_SANDBOX=false
